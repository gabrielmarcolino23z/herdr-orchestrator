#!/usr/bin/env python3
"""SessionStart hook (Claude Code and Codex): record on the herdr terminal how to resume this session.

Usage: mark-session claude|codex   (the hook's JSON arrives on stdin)

Sets the labels `agent`, `session` and, when the hook provides it, `model` on $HC_TERMINAL_ID;
resume-agents reads them after a reboot. For orchestrator-* terminals it also stores the session per
orchestrator, so ensure-projects can reopen a closed orchestrator with the same conversation.
Outside herdr it does nothing. Never fails and never prints: a SessionStart hook's output would
go into the agent's context.
"""
import json
import os
import subprocess
import sys


def main() -> None:
    kind = sys.argv[1] if len(sys.argv) > 1 else ""
    terminal = os.environ.get("HC_TERMINAL_ID")
    if kind not in ("claude", "codex") or not terminal:
        return
    try:
        data = json.load(sys.stdin)
    except Exception:
        data = {}
    session = data.get("session_id")
    model = data.get("model")
    labels = [f"agent={kind}", f"session={session if isinstance(session, str) else ''}"]
    if isinstance(model, str) and model:
        labels.append(f"model={model}")
    quiet = {"stdin": subprocess.DEVNULL, "stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}
    subprocess.run(["hc", "label", terminal, *labels], timeout=5, check=False, **quiet)
    if kind == "claude" and isinstance(session, str) and session:
        r = subprocess.run(["hc", "get", terminal, "--json"], capture_output=True, text=True, timeout=5, check=False)
        name = (json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else {}).get("name") or ""
        if name.startswith("orchestrator-"):
            folder = os.path.expanduser("~/.local/state/herdr-orchestrator/orchestrators")
            os.makedirs(folder, exist_ok=True)
            with open(os.path.join(folder, f"{name}.json"), "w") as f:
                json.dump({"session": session, "cwd": data.get("cwd")}, f)


try:
    main()
except Exception:
    pass
sys.exit(0)
